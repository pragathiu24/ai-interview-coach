# Which backend serves Gemma 4: "ollama" (local) or "gemini" (hosted, later)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
LLM_TIMEOUT=120

# Gemini API (hosted Gemma) - used only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
